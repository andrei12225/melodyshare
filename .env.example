# Public URL of the app. Spotify only accepts loopback IPs (not "localhost") for http redirect URIs,
# so use 127.0.0.1 locally and register  http://127.0.0.1:3000/api/auth/callback  in the Spotify dashboard.
APP_URL=http://127.0.0.1:3000

# From https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Postgres (used by docker compose and by the app)
POSTGRES_USER=melodyshare
POSTGRES_PASSWORD=melodyshare
POSTGRES_DB=melodyshare
POSTGRES_PORT=5432
DATABASE_URL=postgres://melodyshare:melodyshare@127.0.0.1:5432/melodyshare
